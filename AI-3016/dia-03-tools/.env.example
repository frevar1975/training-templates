# Endpoint del proyecto de Microsoft Foundry (sin /openai/v1 al final)
FOUNDRY_PROJECT_ENDPOINT=https://TU-RECURSO.services.ai.azure.com/api/projects/TU-PROYECTO

# Nombre exacto del deployment que aparece en Foundry
MODEL_DEPLOYMENT=gpt-5.2

# Alternativa A: pega aquí la clave del recurso si tu proyecto permite autenticación por clave.
# Déjala vacía para usar Microsoft Entra ID con: az login
AZURE_OPENAI_API_KEY=
